<?xml version="1.0"?>
<robot name="armor_target" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="target_body">
    <inertial>
      <origin xyz="0 0 0.20"/>
      <mass value="20.0"/>
      <inertia ixx="0.53" ixy="0" ixz="0" iyy="0.53" iyz="0" izz="0.53"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.20"/>
      <geometry><box size="0.40 0.40 0.40"/></geometry>
      <material name="blue"><color rgba="0.05 0.15 0.8 1"/></material>
    </visual>
    <collision name="body_collision">
      <origin xyz="0 0 0.20"/>
      <geometry><box size="0.38 0.38 0.38"/></geometry>
    </collision>
  </link>

  <link name="armor_front">
    <visual><geometry><box size="0.02 0.30 0.14"/></geometry><material name="armor"><color rgba="0.1 0.8 1 1"/></material></visual>
    <collision name="armor_front_collision"><geometry><box size="0.02 0.30 0.14"/></geometry></collision>
  </link>
  <joint name="armor_front_joint" type="fixed"><parent link="target_body"/><child link="armor_front"/><origin xyz="-0.205 0 0.20"/></joint>

  <link name="armor_rear">
    <visual><geometry><box size="0.02 0.30 0.14"/></geometry><material name="armor"/></visual>
    <collision name="armor_rear_collision"><geometry><box size="0.02 0.30 0.14"/></geometry></collision>
  </link>
  <joint name="armor_rear_joint" type="fixed"><parent link="target_body"/><child link="armor_rear"/><origin xyz="0.205 0 0.20"/></joint>

  <link name="armor_left">
    <visual><geometry><box size="0.30 0.02 0.14"/></geometry><material name="armor"/></visual>
    <collision name="armor_left_collision"><geometry><box size="0.30 0.02 0.14"/></geometry></collision>
  </link>
  <joint name="armor_left_joint" type="fixed"><parent link="target_body"/><child link="armor_left"/><origin xyz="0 0.205 0.20"/></joint>

  <link name="armor_right">
    <visual><geometry><box size="0.30 0.02 0.14"/></geometry><material name="armor"/></visual>
    <collision name="armor_right_collision"><geometry><box size="0.30 0.02 0.14"/></geometry></collision>
  </link>
  <joint name="armor_right_joint" type="fixed"><parent link="target_body"/><child link="armor_right"/><origin xyz="0 -0.205 0.20"/></joint>

  <gazebo><static>true</static></gazebo>
  <gazebo reference="target_body"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="armor_front"><material>Gazebo/Cyan</material></gazebo>
  <gazebo reference="armor_rear"><material>Gazebo/Cyan</material></gazebo>
  <gazebo reference="armor_left"><material>Gazebo/Cyan</material></gazebo>
  <gazebo reference="armor_right"><material>Gazebo/Cyan</material></gazebo>
</robot>
